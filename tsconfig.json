{
  "compilerOptions": {
    "target": "es2015",
    "module": "commonjs",
    "moduleResolution": "node10",
    // node10 resolution is deprecated in TypeScript 6 and removed in 7. Moving off
    // it is a separate migration (it forces `module` off commonjs), so silence it
    // for now.
    "ignoreDeprecations": "6.0",
    // TypeScript 6 flipped `strict` to default-on; this project was written
    // against the pre-6 default.
    "strict": false,
    "lib": [
      "es2021",
      "dom"
    ],
    "typeRoots": [
      "./node_modules/@types",
      "./types"
    ],
    "declaration": true,
    "esModuleInterop": true,
    "outDir": "dist"
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "vitest.setup.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    // The test dapp is an ESM package with its own tsconfig - Hardhat 3 only runs in ESM
    // projects, and this project compiles as commonjs
    "test/dapp"
  ]
}
